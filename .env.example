# Optional. Sentry DSN is hardcoded in main.tsx (not a secret -- Sentry
# designs these to be public); set this only to override it, e.g. to point
# at a different Sentry project. VITE_SENTRY_ENVIRONMENT defaults to
# "development" if unset -- real releases should set it to "production"
# explicitly so events are tagged and filterable separately from local dev.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=
VITE_SENTRY_ENVIRONMENT=
